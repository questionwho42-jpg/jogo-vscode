import dearpygui.dearpygui as dpg

def show_map_editor(sender, app_data):
    # Verifica se a janela já existe para não abrir duas vezes
    if dpg.does_item_exist("janela_mapa"):
        dpg.show_item("janela_mapa") # Garante que ela apareça se estiver oculta
        dpg.focus_item("janela_mapa")
        return

    with dpg.window(tag="janela_mapa", label="Editor de Mapas", width=800, height=600):
        dpg.add_text("Area de Desenho do Mapa (Grid 32x32)")
        
        # Cria uma área de desenho
        with dpg.drawlist(width=800, height=500):
            # Desenha linhas verticais (Grid)
            for i in range(0, 800, 32):
                dpg.draw_line((i, 0), (i, 500), color=(255, 255, 255, 30), thickness=1)
            # Desenha linhas horizontais (Grid)
            for i in range(0, 500, 32):
                dpg.draw_line((0, i), (800, i), color=(255, 255, 255, 30), thickness=1)

def run_editor():
    # 1. Criar o contexto (a "alma" da interface)
    dpg.create_context()
    
    # 2. Configurar a Janela Principal (Viewport)
    # Aqui definimos o nome que aparece na barra do Windows e o tamanho inicial
    dpg.create_viewport(title='Pandorha Forge - Editor de RPG', width=1280, height=720)
    dpg.setup_dearpygui()
    
    # 3. Habilitar o sistema de "Docking"
    # Isso permite que você arraste painéis e organize seu editor como quiser
    dpg.configure_app(docking=True, docking_space=True)

    # 4. Criar a Barra de Menu Superior
    with dpg.viewport_menu_bar():
        with dpg.menu(label="Arquivo"):
            dpg.add_menu_item(label="Novo Projeto")
            dpg.add_menu_item(label="Salvar")
            dpg.add_separator()
            dpg.add_menu_item(label="Sair", callback=dpg.stop_dearpygui)
            
        with dpg.menu(label="Modulos"):
            dpg.add_menu_item(label="Editor de Mapas", callback=show_map_editor)
            dpg.add_menu_item(label="Editor de NPCs")

    # 5. Exibir a janela e rodar o loop principal
    dpg.show_viewport()
    dpg.start_dearpygui()
    dpg.destroy_context()

if __name__ == "__main__":
    run_editor()